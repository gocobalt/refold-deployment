{
  "alert": "JarvisPodNotReady",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "kube_pod_status_ready{condition=\"false\",namespace=\"<NAMESPACE>\"} * on(pod, namespace) group_left() kube_pod_labels{label_resource_name=~\"ai-python-app|ai-python-worker\",namespace=\"<NAMESPACE>\"}",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "op": "1",
    "target": 0,
    "matchType": "2",
    "requireMinPoints": true,
    "requiredNumPoints": 2
  },
  "labels": {
    "namespace": "<NAMESPACE>",
    "service": "jarvis",
    "severity": "1"
  },
  "annotations": {
    "resolution": "Pod not Ready. kubectl -n {{ $labels.namespace }} describe pod <pod> (events/probes); verify readiness probe and upstream dependencies.",
    "summary": "jarvis pod {{ $labels.pod }} (ns={{ $labels.namespace }}) NotReady"
  },
  "disabled": false,
  "preferredChannels": [],
  "version": "v5"
}
