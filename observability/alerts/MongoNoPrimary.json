{
  "alert": "MongoNoPrimary",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "absent(mongodb_mongod_replset_my_state{cluster=\"<MONGO_CLUSTER>\"} == 1)",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "op": "1",
    "target": 0,
    "matchType": "2",
    "requireMinPoints": true,
    "requiredNumPoints": 2
  },
  "labels": {
    "namespace": "<NAMESPACE>",
    "service": "mongodb",
    "severity": "1"
  },
  "annotations": {
    "description": "No member reporting state==1 (PRIMARY) for 1m. Cluster is unwritable.",
    "resolution": "No primary / replset member down. Check rs.status() and node health; trigger failover or restart the member.",
    "summary": "mongo replset has no PRIMARY"
  },
  "disabled": false,
  "preferredChannels": [],
  "version": "v5"
}
