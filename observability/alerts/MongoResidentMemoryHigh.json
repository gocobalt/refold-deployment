{
  "alert": "MongoResidentMemoryHigh",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "evalWindow": "10m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "( mongodb_memory{type=\"resident\",cluster=\"<MONGO_CLUSTER>\"} * 1024 * 1024 / on() group_left() max(node_memory_MemTotal_bytes * on(node) group_left() kube_pod_info{pod=~\"mongo-exporter-mongodb-service-.*\"}) )",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "op": "1",
    "target": 0.85,
    "matchType": "2",
    "selectedQueryName": "A",
    "requireMinPoints": true,
    "requiredNumPoints": 9
  },
  "labels": {
    "namespace": "<NAMESPACE>",
    "service": "mongodb",
    "severity": "2"
  },
  "annotations": {
    "description": "Resident memory pressure. Vertical scaling may be needed.",
    "resolution": "Mongo under sustained resource pressure -- consider scaling the cluster tier vertically.",
    "summary": "mongo resident memory > 85% of node memory"
  },
  "disabled": false,
  "preferredChannels": [],
  "version": "v5"
}
