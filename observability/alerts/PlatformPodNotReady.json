{
  "alert": "PlatformPodNotReady",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "( kube_pod_status_ready{condition=\"false\",namespace=\"<NAMESPACE>\"} * on(pod, namespace) group_left(label_resource_name) kube_pod_labels{label_resource_type=\"service\",label_resource_name!~\"ai-python-app|ai-python-worker|audit-service-v2|bkout-integration-auth-backend|bkout-one-workflow-backend|integration-service|workflow-queue-workers\",namespace=\"<NAMESPACE>\"} )",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "op": "1",
    "target": 0,
    "matchType": "2",
    "requireMinPoints": true,
    "requiredNumPoints": 4
  },
  "labels": {
    "namespace": "<NAMESPACE>",
    "service": "platform",
    "severity": "1"
  },
  "annotations": {
    "description": "A pod has been NotReady for >5m. Check kubelet/readiness probe.",
    "resolution": "Pod not Ready. kubectl -n {{ $labels.namespace }} describe pod <pod> (events/probes); verify readiness probe and upstream dependencies.",
    "service_dynamic": "{{ $labels.label_resource_name }}",
    "summary": "{{ $labels.label_resource_name }} pod {{ $labels.pod }} (ns={{ $labels.namespace }}) NotReady for 5m"
  },
  "disabled": false,
  "preferredChannels": [],
  "version": "v5"
}
