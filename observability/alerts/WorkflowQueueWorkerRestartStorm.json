{
  "alert": "WorkflowQueueWorkerRestartStorm",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "evalWindow": "5m0s",
  "frequency": "1m0s",
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "increase(kube_pod_container_status_restarts_total{namespace=\"<NAMESPACE>\"}[10m]) * on(pod, namespace) group_left() kube_pod_labels{label_resource_name=\"workflow-queue-workers\",namespace=\"<NAMESPACE>\"}",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": ""
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "op": "1",
    "target": 3,
    "matchType": "2",
    "requireMinPoints": true,
    "requiredNumPoints": 2
  },
  "labels": {
    "component": "queue-workers",
    "namespace": "<NAMESPACE>",
    "service": "workflow",
    "severity": "1"
  },
  "annotations": {
    "resolution": "Repeated restarts. kubectl -n {{ $labels.namespace }} describe pod <pod> (last state/OOM); kubectl -n {{ $labels.namespace }} logs <pod> --previous; check recent deploy/config; roll back if needed.",
    "summary": "workflow queue-worker pod {{ $labels.pod }} (ns={{ $labels.namespace }}) restarted >3 times in 10m"
  },
  "disabled": false,
  "preferredChannels": [],
  "version": "v5"
}
