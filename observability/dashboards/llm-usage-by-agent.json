    "panels": {
      "w-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Calls/sec by agent",
            "description": ""
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (agent) (rate(llm_calls_total{namespace=~\"$namespace\", environment=~\"$environment\", agent=~\"$agent\", model=~\"$model\"}[$__rate_interval]))",
                    "disabled": false,
                    "step": 0,
                    "stats": false,
                    "legend": "{{agent}}"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
